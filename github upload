    s.items.forEach(o=>{const done=o.reps.filter(r=>r!=null);const ok=done.length===o.sets&&o.reps.every(r=>r>=o.lo);
      const sets=o.ws?o.reps.map((r,j)=>fmt(wAt(o,j))+"×"+(r==null?"–":r)).join(", "):o.reps.map(r=>r==null?"–":r).join("/");
      h+=`<div class="hist-ex"><span>${esc(o.n)} <span class="muted">${o.ws||o.k==="bodyweight"?"":fmt(o.w)+" kg"}</span></span><span class="reps">${sets}${o.bo?" · "+fmt(o.bo.w)+"×"+o.bo.reps.map(r=>r==null?"–":r).join("/"):""}${s.imp?"":` <span class="mark ${ok?"ok":"bad"}">${ok?"✓":"✗"}</span>`}</span></div>`});
    if(open){
