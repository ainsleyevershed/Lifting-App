/* ---- Progress ---- */
function lineChart(series,opts){
  opts=opts||{};const W=640,H=opts.h||220,pl=44,pr=16,pt=14,pb=26;
  const pts=series.flatMap(s=>s.pts);
  if(pts.length<2)return `<p class="empty">Log at least two sessions of this exercise to see a trend line.</p>`;
  let ys=pts.map(p=>p.y);if(opts.target)ys.push(opts.target);
  let lo=Math.min(...ys),hi=Math.max(...ys);if(hi-lo<5){lo-=2.5;hi+=2.5}
  const raw=(hi-lo)/4,mag=Math.pow(10,Math.floor(Math.log10(raw)));const step=[1,2,2.5,5,10].map(x=>x*mag).find(x=>x>=raw);
  lo=Math.floor(lo/step)*step;hi=Math.ceil(hi/step)*step;
  const ts=pts.map(p=>p.t),t0=Math.min(...ts),t1=Math.max(...ts)||t0+1,span=Math.max(1,t1-t0);
  const X=t=>pl+(W-pl-pr)*((t-t0)/span),Y=v=>pt+(H-pt-pb)*(1-(v-lo)/(hi-lo));
  let g=`<g class="grid">`;for(let v=lo;v<=hi+1e-9;v+=step)g+=`<line x1="${pl}" x2="${W-pr}" y1="${Y(v)}" y2="${Y(v)}"/><text x="${pl-6}" y="${Y(v)+4}" text-anchor="end">${fmt(v)}</text>`;
  const nx=Math.min(4,new Set(ts).size);for(let i=0;i<nx;i++){const t=t0+span*(nx===1?0:i/(nx-1));const dd=new Date(t),lbl=span>300*864e5?MON[dd.getMonth()]+" "+dd.getFullYear():dshort(dd.toISOString());g+=`<text x="${X(t)}" y="${H-6}" text-anchor="${i===0?"start":i===nx-1?"end":"middle"}">${lbl}</text>`}
  g+=`</g>`;
  let body="";
  if(opts.target&&opts.target<=hi)body+=`<line class="tgt" x1="${pl}" x2="${W-pr}" y1="${Y(opts.target)}" y2="${Y(opts.target)}"/><text class="tgtl" x="${W-pr}" y="${Y(opts.target)-5}" text-anchor="end">Goal ${fmt(opts.target)}</text>`;
  series.forEach((s,si)=>{if(!s.pts.length)return;const P2=s.pts.slice().sort((a,b)=>a.t-b.t);const d=P2.map((p,i)=>(i?"L":"M")+X(p.t).toFixed(1)+" "+Y(p.y).toFixed(1)).join(" ");
    if(si===0&&P2.length>1)body+=`<path class="s1a" d="${d} L${X(P2[P2.length-1].t).toFixed(1)} ${H-pb} L${X(P2[0].t).toFixed(1)} ${H-pb} Z"/>`;
    body+=`<path class="${si===0?"s1":"s2"}" d="${d}"/>`;
    if(si===0){const e=P2[P2.length-1];body+=`<circle class="dot" cx="${X(e.t)}" cy="${Y(e.y)}" r="4.5"/>`}});
  return `<div class="chart"><svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(opts.label||"Trend chart")}">${g}${body}</svg></div>`;
}
function vProgress(){
  const cnt={};S.forEach(s=>s.items.forEach(o=>{cnt[o.ex]=(cnt[o.ex]||0)+1}));
  const chipList=[...new Set([...MAIN,...["A","B"].flatMap(d=>P.plan[d].map(r=>r.ex))])];
  const others=Object.keys(cnt).filter(k=>!chipList.includes(k)).sort((a,b)=>exName(a).localeCompare(exName(b)));
  if(!cnt[ui.progEx]&&!chipList.includes(ui.progEx))ui.progEx="squat";
  let h=`<div class="stack"><h1>Progress</h1><h2>Goals</h2><div class="grid2">`;
  P.settings.goals.forEach(g=>{
    const best=bestE1(g.ex,Date.now()-84*864e5),allB=bestE1(g.ex),cur=P.state[g.ex]?P.state[g.ex].w:0,curE=Math.max(best,0);
    const pct=Math.min(100,Math.round(100*curE/g.target));
    const hr=heavyReps(g.ex),need5=hr===1?g.target:g.target/(1+hr/30),fq=cycleFreq(g.ex),inc=2.5;
    let proj="";
    if(curE>=g.target)proj=`Goal reached. Time to set a new one.`;
    else if(fq>0){const sess=Math.max(0,Math.ceil((need5-cur)/inc));const wk=Math.ceil(sess/fq);proj=`A ${hr}-rep set of about ${fmt(r25(need5))} kg predicts ${g.target} kg. At +2.5 kg per successful session (${fmt(fq)}× a week), that's roughly <b>${wk} weeks</b> at best. Expect stalls and deloads to stretch this.`}
    else proj=`${exName(g.ex)} isn't a heavy lift in your current plan, so it won't progress on its own.`;
    h+=`<div class="card goal"><div class="spread"><b>${esc(exName(g.ex))}</b><span class="num" style="font-size:20px">${curE?fmt(Math.round(curE*2)/2):"–"} <span class="muted" style="font-size:15px">/ ${g.target} kg</span></span></div><div class="gbar" role="progressbar" aria-valuenow="${pct}" aria-valuemin="0" aria-valuemax="100"><i style="width:${pct}%"></i></div><div class="small muted">Estimated 1RM from your best set in the last 12 weeks${allB>curE+0.01?`. All-time best: ${fmt(Math.round(allB*2)/2)} kg`:""}. Working weight now ${fmt(cur)} kg.</div><div class="small">${proj}</div></div>`;
  });
  const rng=ui.range||"1y";
  h+=`</div><h2>Lift detail</h2><div class="chips">${chipList.map(k=>`<button class="chip ${k===ui.progEx?"on":""}" data-act="prog" data-v="${k}">${esc(exName(k))}</button>`).join("")}</div>`;
  if(others.length)h+=`<label class="f">Other exercises in your history<select class="in" id="prog-other" data-act="prog-sel"><option value="">Choose…</option>${others.map(k=>`<option value="${esc(k)}" ${k===ui.progEx?"selected":""}>${esc(exName(k))} (${cnt[k]})</option>`).join("")}</select></label>`;
  const ex=ui.progEx,k=kindOf(ex),hist=[];
  const since={"3m":Date.now()-91*864e5,"1y":Date.now()-365*864e5,"all":0}[rng];
  S.slice().reverse().forEach(s=>{const t=new Date(s.date).getTime();if(t<since)return;s.items.forEach(o=>{if(o.ex!==ex)return;const idx=o.reps.map((r,j)=>j).filter(j=>o.reps[j]!=null);if(!idx.length)return;
    const best=Math.max(0,...idx.map(j=>e1rm(wAt(o,j),o.reps[j])));const top=Math.max(...idx.map(j=>wAt(o,j)));
    const vol=idx.reduce((a,j)=>a+o.reps[j]*wAt(o,j),0)+(o.bo?o.bo.reps.filter(r=>r).reduce((a,r)=>a+r*o.bo.w,0):0);
    hist.push({t,e:best,w:top,reps:idx.map(j=>o.ws?fmt(wAt(o,j))+"×"+o.reps[j]:o.reps[j]),vol,sum:idx.reduce((a,j)=>a+o.reps[j],0),pct:o.pct||100,imp:!!o.ws})})});
  h+=`<div class="chips">${[["3m","3 months"],["1y","1 year"],["all","All time"]].map(([v,l])=>`<button class="chip ${rng===v?"on":""}" data-act="range" data-v="${v}">${l}</button>`).join("")}</div>`;
  const g=P.settings.goals.find(x=>x.ex===ex);
  const bestE=hist.reduce((a,b)=>Math.max(a,b.e),0),bestW=hist.reduce((a,b)=>Math.max(a,b.w),0);
  const fourWk=Date.now()-28*864e5,vol4=hist.filter(x=>x.t>=fourWk).reduce((a,b)=>a+b.vol,0);
  h+=`<div class="card stack"><div class="stats">
    <div class="stat"><span class="v">${k==="barbell"||k==="cable"||k==="dumbbell"?fmt(P.state[ex].w):"–"}</span><span class="k">Working weight, kg</span></div>
    <div class="stat"><span class="v">${bestE?fmt(Math.round(bestE*2)/2):"–"}</span><span class="k">Best est. 1RM, kg</span></div>
    <div class="stat"><span class="v">${bestW?fmt(bestW):"–"}</span><span class="k">Heaviest set, kg</span></div>
    <div class="stat"><span class="v">${vol4?Math.round(vol4).toLocaleString("en-GB"):"–"}</span><span class="k">Volume last 4 wks, kg</span></div></div>`;
  const useReps=k==="fixed"||k==="bodyweight"||!hist.some(x=>x.e>0);
  if(useReps){h+=lineChart([{pts:hist.map(x=>({t:x.t,y:x.sum}))}],{label:"Total reps per session"});h+=`<div class="legend"><span><i></i>Total reps per session</span></div>`}
  else{h+=lineChart([{pts:hist.filter(x=>x.e>0).map(x=>({t:x.t,y:Math.round(x.e*10)/10}))},{pts:hist.filter(x=>x.pct>=100).map(x=>({t:x.t,y:x.w}))}],{target:g&&g.target,label:"Estimated 1RM and heaviest set"});
    h+=`<div class="legend"><span><i></i>Estimated 1RM</span><span><i class="d"></i>Heaviest set</span>${g?`<span><i class="g"></i>Goal</span>`:""}</div>`}
  if(hist.length){h+=`<div class="scroll"><table class="tbl"><thead><tr><th>Date</th><th class="r">Top kg</th><th>Sets</th><th class="r">e1RM</th></tr></thead><tbody>${hist.slice(-12).reverse().map(x=>`<tr><td>${dshort(new Date(x.t).toISOString())}${x.imp?` <span class="muted small">GD</span>`:""}</td><td class="r num">${fmt(x.w)}</td><td class="num">${x.reps.join(x.imp?", ":"/")}</td><td class="r num">${x.e?fmt(Math.round(x.e*2)/2):"–"}</td></tr>`).join("")}</tbody></table></div>`}
  else h+=`<p class="empty">Nothing logged for ${esc(exName(ex))} in this period.</p>`;
  h+=`<p class="muted small">Estimated 1RM uses the Epley formula (weight × (1 + reps ÷ 30)) on sets of 10 reps or fewer. It's a guide, not a tested max.</p></div></div>`;
  return h;
}

