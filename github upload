/* Gym Day CSV: Date,Workout name,Exercise,Set,Weight,Reps,Distance,Duration,Measurement unit,Notes */
const GD_MAP={"barbell bench press":"bench","barbell squat":"squat","barbell deadlifts":"deadlift","standing barbell military press":"ohp","bent over barbell row":"row",
  "barbell front squat":"front_squat","close grip barbell bench press":"cg_bench","incline barbell bench press":"incline","barbell romanian deadlift":"rdl",
  "seated cable rows":"cable_row","wide grip lat pull down":"lat_pulldown","face pull":"face_pull","rope pushdown":"rope_pushdown","rope bicep curl":"cable_curl",
  "lateral dumbbell raises":"lateral_raise","push ups":"pushup","dumbbell hammer curls":"hammer_curl"};
function parseCSV(text){const out=[];let row=[],f="",q=false;for(let i=0;i<text.length;i++){const c=text[i];if(q){if(c==='"'){if(text[i+1]==='"'){f+='"';i++}else q=false}else f+=c}else if(c==='"')q=true;else if(c===","){row.push(f);f=""}else if(c==="\n"||c==="\r"){if(c==="\r"&&text[i+1]==="\n")i++;row.push(f);f="";if(row.length>1||row[0]!=="")out.push(row);row=[]}else f+=c}if(f!==""||row.length){row.push(f);out.push(row)}return out}
function gymDaySessions(text){
  const rows=parseCSV(text.replace(/^﻿/,""));if(!rows.length)throw new Error("empty");
  const hd=rows[0].map(x=>x.trim().toLowerCase()),ix=n=>hd.indexOf(n);
  const iD=ix("date"),iW=ix("workout name"),iE=ix("exercise"),iWt=ix("weight"),iR=ix("reps"),iU=ix("measurement unit");
  if(iD<0||iE<0||iWt<0||iR<0)throw new Error("format");
  const by=new Map();
  rows.slice(1).forEach(r=>{
    const m=/^(\d{1,2})\/(\d{1,2})\/(\d{4})\s*(\d{1,2})?:?(\d{2})?/.exec(r[iD]||"");if(!m)return;
    const reps=parseInt(r[iR],10);if(!(reps>0))return;
    let w=parseFloat(r[iWt]);if(isNaN(w))w=0;const unit=(r[iU]||"kg").trim().toLowerCase();if(unit==="lb"||unit==="lbs")w=Math.round(w*0.45359237*100)/100;else if(unit&&unit!=="kg")return;
    const key=r[iD].trim();
    if(!by.has(key)){const d=new Date(+m[3],+m[2]-1,+m[1],+(m[4]||12),+(m[5]||0));by.set(key,{id:"gd-"+m[3]+m[2].padStart(2,"0")+m[1].padStart(2,"0")+(m[4]||"12").padStart(2,"0")+(m[5]||"00"),date:d.toISOString(),day:"A",imp:true,wname:(r[iW]||"").trim(),items:[],ex:new Map()})}
    const s=by.get(key),nm=(r[iE]||"").trim(),low=nm.toLowerCase();
    if(!s.ex.has(low)){const id=GD_MAP[low]||("gd-"+low.replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,""));const o={ex:id,n:EX[id]?EX[id].n:nm,k:EX[id]?EX[id].k:"other",w:0,ws:[],reps:[],sets:0,lo:0,hi:0,pct:100};s.ex.set(low,o);s.items.push(o)}
    const o=s.ex.get(low);o.ws.push(w);o.reps.push(reps);o.sets++;o.w=Math.max(o.w,w);
  });
  return [...by.values()].map(s=>{delete s.ex;return s}).filter(s=>s.items.length);
}
async function importGymDay(file){
  const out=document.getElementById("gd-out");
  const text=await file.text().catch(()=>null);
  let sess;try{sess=gymDaySessions(text||"")}catch(e){out.innerHTML=`<div class="note bad">That doesn't look like a Gym Day export. Choose the CSV the app produced (it starts with "Date,Workout name,Exercise").</div>`;return}
  if(!sess.length){out.innerHTML=`<div class="note bad">No workouts with reps were found in that file.</div>`;return}
  const ids=new Set(sess.map(s=>s.id));S=S.filter(s=>!ids.has(s.id)).concat(sess);sortData();cacheLocal();
  let done=0,fail=0;const total=sess.length;
  const prog=()=>{out.innerHTML=`<div class="note">${mode==="cloud"?`Saving to your account: ${done} of ${total}…`:`Imported ${total} workouts.`}</div>`};prog();
  if(mode==="cloud"){for(let i=0;i<sess.length;i+=8){const batch=sess.slice(i,i+8);const res=await Promise.all(batch.map(s=>refs.prof.collection("sessions").doc(s.id).set(s).then(()=>1,()=>0)));res.forEach(r=>r?done++:fail++);prog()}setSync(fail?"warn":"ok",fail?"Some imports not saved":"Saved")}
  const yrs=[...new Set(sess.map(s=>s.date.slice(0,4)))].sort();
  out.innerHTML=`<div class="note ok">Imported ${total} Gym Day workouts (${yrs[0]}–${yrs[yrs.length-1]}).${fail?` ${fail} couldn't be saved to your account; import the file again to retry.`:""} See them on History and Progress.</div>`;
}
let pendingImport=null;
function handleImport(file){const fr=new FileReader();fr.onload=()=>{try{const j=JSON.parse(fr.result);if(!j||!j.profile||!Array.isArray(j.sessions))throw 0;pendingImport=j;openModal(`<h2>Restore backup?</h2><p>This replaces your plan, weights and settings, and adds ${j.sessions.length} sessions and ${(j.body||[]).length} body entries (matching entries are overwritten).</p><div class="row"><button class="btn primary" data-act="imp-go">Restore</button><button class="btn" data-act="close">Cancel</button></div>`)}catch(e){openModal(`<h2>That file didn't work</h2><p>Choose a JSON backup made with "Back up (JSON)" in this app.</p><button class="btn primary" data-act="close">OK</button>`)}};fr.readAsText(file)}
async function doImport(){const j=pendingImport;pendingImport=null;closeModal();P=normalise(j.profile);const ids=new Set(S.map(s=>s.id));for(const s of j.sessions){if(ids.has(s.id))S=S.filter(x=>x.id!==s.id);S.push(s)}const bids=new Set(BW.map(b=>b.id));for(const b of (j.body||[])){if(bids.has(b.id))BW=BW.filter(x=>x.id!==b.id);BW.push(b)}sortData();D=null;lsDel("ll.draft");saveProfile();for(const s of j.sessions)await saveDoc("sessions",s);for(const b of (j.body||[]))await saveDoc("body",b);render()}

/* ---------- events ---------- */
