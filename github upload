<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#101214">
<meta name="description" content="Home-gym lifting log: 5×5 and hybrid plans, auto-progression, plate maths, rest timer and progress charts.">
<link rel="manifest" href="manifest.json">
<link rel="icon" type="image/png" sizes="192x192" href="icons/icon-192.png">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<style>:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}body{margin:0}img{max-width:100%}</style>
<title>Lifting Log</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap">
<style>
/* Layout: single 720px training column, sticky header, bottom tab bar like a gym app; plates drawn in competition colours */
:root{
  --bg:#eceef1; --surface:#ffffff; --surface-2:#e2e6eb; --fg:#14171b; --muted:#59626d; --line:#cdd3da;
  --accent:#c8302a; --accent-fg:#ffffff; --accent-soft:#f6dcda;
  --ok:#1d7f47; --ok-soft:#d7efe1; --warn:#a86a12; --warn-soft:#f6e8cf;
  --p20:#1f5fbf; --p15:#d9a900; --p10:#2d8a44; --p5:#f4f5f6; --p25:#c8302a; --p125:#98a1aa; --pother:#59626d;
  --display:"Barlow Condensed","Arial Narrow",system-ui,sans-serif;
  --body:"Barlow",system-ui,-apple-system,"Segoe UI",sans-serif;
  --r:10px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#101214; --surface:#191c20; --surface-2:#23272d; --fg:#eceef0; --muted:#9aa3ad; --line:#30353c;
  --accent:#ff5245; --accent-fg:#16090a; --accent-soft:#3a1d1b;
  --ok:#4cc27e; --ok-soft:#173226; --warn:#e5a44a; --warn-soft:#3a2c17;
  --p5:#dfe2e5; --pother:#7d8792; color-scheme:dark }}
:root[data-theme="dark"]{
  --bg:#101214; --surface:#191c20; --surface-2:#23272d; --fg:#eceef0; --muted:#9aa3ad; --line:#30353c;
  --accent:#ff5245; --accent-fg:#16090a; --accent-soft:#3a1d1b;
  --ok:#4cc27e; --ok-soft:#173226; --warn:#e5a44a; --warn-soft:#3a2c17;
  --p5:#dfe2e5; --pother:#7d8792; color-scheme:dark }
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{background:var(--bg);color:var(--fg)}
body{font-family:var(--body);font-size:15px;line-height:1.45;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--bg)}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.wrap{max-width:720px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
header.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:10px}
.brand{font-family:var(--display);font-weight:700;font-size:22px;letter-spacing:.02em;text-transform:uppercase;display:flex;align-items:center;gap:8px;white-space:nowrap}
.brand .bar{display:inline-flex;align-items:center;gap:2px}
.brand .bar i{display:block;width:5px;border-radius:2px}
.pill{font-size:12px;padding:3px 9px;border-radius:999px;background:var(--surface-2);color:var(--muted);white-space:nowrap}
.pill.ok{background:var(--ok-soft);color:var(--ok)}
.pill.warn{background:var(--warn-soft);color:var(--warn)}
main{padding-block:16px 150px}
h1,h2,h3{font-family:var(--display);font-weight:700;letter-spacing:.01em;margin:0;text-wrap:balance}
h1{font-size:30px;text-transform:uppercase}
h2{font-size:21px;text-transform:uppercase}
h3{font-size:18px}
.eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.muted{color:var(--muted)}
.small{font-size:13px}
.num{font-family:var(--display);font-variant-numeric:tabular-nums}
.stack{display:flex;flex-direction:column;gap:14px}
.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.spread{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:14px}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:8px 14px;font-weight:600}
.btn:hover{border-color:var(--muted)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}
.btn.ghost{background:transparent}
.btn.sm{padding:5px 10px;font-size:13px}
.btn.big{width:100%;padding:14px;font-size:17px;font-family:var(--display);text-transform:uppercase;letter-spacing:.05em}
.btn.danger{color:var(--accent);border-color:var(--accent)}
.chip{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:4px 11px;font-size:13px;font-weight:500}
.chip:disabled:not(.on){opacity:.45;cursor:default}
.chip.on{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.chips{display:flex;gap:6px;flex-wrap:wrap}
/* Today */
.daybar{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;flex-wrap:wrap}
.daytag{display:inline-grid;place-items:center;width:44px;height:44px;border-radius:8px;background:var(--fg);color:var(--bg);font-family:var(--display);font-weight:700;font-size:28px}
.ex{display:flex;flex-direction:column;gap:10px}
.ex-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.ex-title{display:flex;flex-direction:column;gap:2px;min-width:0}
.scheme{font-family:var(--display);font-size:16px;color:var(--muted);letter-spacing:.02em}
.wctl{display:flex;align-items:center;gap:4px;flex-shrink:0}
.wctl button{width:34px;height:34px;border-radius:8px;border:1px solid var(--line);background:var(--surface-2);font-size:18px;font-weight:600;line-height:1}
.wval{font-family:var(--display);font-weight:700;font-size:26px;min-width:76px;text-align:center;font-variant-numeric:tabular-nums}
.wval small{font-size:14px;color:var(--muted);font-weight:500;margin-left:2px}
.sets{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.set{width:48px;height:48px;border-radius:50%;border:2px solid var(--line);background:var(--surface-2);font-family:var(--display);font-size:20px;font-weight:700;color:var(--muted);display:grid;place-items:center;transition:transform .08s}
.set:active{transform:scale(.93)}
.set.hit{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}
.set.part{background:var(--surface);border-color:var(--accent);color:var(--accent)}
.set.mid{background:var(--fg);border-color:var(--fg);color:var(--bg)}
.setlbl{font-size:12px;color:var(--muted);width:100%}
.warm{display:flex;gap:6px;flex-wrap:wrap}
.wchip{border:1px dashed var(--line);background:transparent;border-radius:8px;padding:4px 8px;font-size:13px;text-align:left;line-height:1.25}
.wchip b{font-family:var(--display);font-size:15px}
.wchip span{display:block;font-size:11px;color:var(--muted)}
.wchip.done{border-style:solid;background:var(--surface-2);color:var(--muted);text-decoration:line-through}
.plates{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:13px;color:var(--muted)}
.pviz{display:flex;align-items:center;height:40px}
.pviz .sleeve{width:16px;height:6px;background:var(--p125);border-radius:1px}
.pviz .collar{width:4px;height:14px;background:var(--muted);margin-right:1px}
.plate{width:9px;border-radius:2px;margin-right:2px;border:1px solid rgba(0,0,0,.18)}
.plate.p20{background:var(--p20);height:40px}.plate.p15{background:var(--p15);height:36px}.plate.p10{background:var(--p10);height:32px}
.plate.p5{background:var(--p5);height:24px}.plate.p2_5{background:var(--p25);height:19px;width:7px}.plate.p1_25{background:var(--p125);height:15px;width:6px}.plate.pother{background:var(--pother);height:20px}
.note{font-size:13px;padding:7px 10px;border-radius:8px;background:var(--surface-2);color:var(--muted)}
.note.warn{background:var(--warn-soft);color:var(--warn)}
.note.bad{background:var(--accent-soft);color:var(--accent)}
.note.ok{background:var(--ok-soft);color:var(--ok)}
.toggle{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:3px 10px;background:transparent}
.toggle.on{background:var(--warn-soft);border-color:var(--warn);color:var(--warn)}
details summary{cursor:pointer;font-size:13px;color:var(--muted);list-style:none}
details summary::-webkit-details-marker{display:none}
details summary::before{content:"▸ ";}
details[open] summary::before{content:"▾ ";}
/* timer */
#timer{position:fixed;left:0;right:0;bottom:calc(58px + env(safe-area-inset-bottom,0px));z-index:25;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
#timer .tin{max-width:720px;margin:0 auto 8px;background:var(--fg);color:var(--bg);border-radius:12px;padding:10px 12px;display:flex;align-items:center;gap:10px;box-shadow:0 6px 24px rgba(0,0,0,.25)}
#timer .tclock{font-family:var(--display);font-size:30px;font-weight:700;min-width:74px;font-variant-numeric:tabular-nums}
#timer .tmsg{flex:1;min-width:0;font-size:13px;line-height:1.3}
#timer .tbar{height:3px;background:rgba(127,127,127,.35);border-radius:2px;margin-top:4px;overflow:hidden}
#timer .tbar i{display:block;height:100%;background:var(--accent)}
#timer button{background:transparent;border:1px solid rgba(127,127,127,.5);color:inherit;border-radius:7px;padding:5px 8px;font-size:13px;font-weight:600}
#timer.done .tin{background:var(--accent);color:var(--accent-fg)}
/* nav */
nav.tabs{position:fixed;left:0;right:0;bottom:0;z-index:24;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px);padding-left:env(safe-area-inset-left,0px);padding-right:env(safe-area-inset-right,0px)}
nav.tabs .tin{max-width:720px;margin:0 auto;display:grid;grid-template-columns:repeat(6,1fr)}
nav.tabs button{background:none;border:0;padding:8px 2px 9px;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:11px;font-weight:600;color:var(--muted);letter-spacing:.02em}
nav.tabs button svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
nav.tabs button.on{color:var(--accent)}
/* tables, lists */
.tbl{width:100%;border-collapse:collapse;font-size:14px}
.tbl th{text-align:left;font-size:12px;color:var(--muted);font-weight:600;padding:6px 6px;border-bottom:1px solid var(--line)}
.tbl td{padding:7px 6px;border-bottom:1px solid var(--line);vertical-align:middle}
.tbl td.r,.tbl th.r{text-align:right}
.scroll{overflow-x:auto}
.hist-item{display:flex;flex-direction:column;gap:6px}
.hist-ex{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;font-size:14px;padding:4px 0;border-top:1px dashed var(--line)}
.reps{font-family:var(--display);font-size:15px;letter-spacing:.04em;color:var(--muted)}
.mark{font-weight:700}
.mark.ok{color:var(--ok)}.mark.bad{color:var(--accent)}
/* calendar */
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center}
.cal .dh{font-size:11px;color:var(--muted);font-weight:600;padding-bottom:2px}
.cal .d{aspect-ratio:1;max-width:100%;border-radius:8px;display:grid;place-items:center;font-size:13px;position:relative;font-variant-numeric:tabular-nums}
.cal .d.out{opacity:.3}
.cal .d.today{outline:1.5px solid var(--muted)}
.cal .d.A{background:var(--accent);color:var(--accent-fg);font-weight:700}
.cal .d.B{background:var(--fg);color:var(--bg);font-weight:700}
.cal .d.GD{background:var(--surface-2);color:var(--fg);font-weight:700;box-shadow:inset 0 -3px 0 var(--muted)}
/* goals */
.goal{display:flex;flex-direction:column;gap:6px}
.gbar{height:10px;border-radius:5px;background:var(--surface-2);overflow:hidden}
.gbar i{display:block;height:100%;background:var(--accent);border-radius:5px}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:12px}
.stat{display:flex;flex-direction:column;gap:2px}
.stat .v{font-family:var(--display);font-size:26px;font-weight:700;font-variant-numeric:tabular-nums}
.stat .k{font-size:12px;color:var(--muted)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:12px}
/* chart */
.chart svg{width:100%;height:auto;display:block}
.chart .grid line{stroke:var(--line);stroke-width:1}
.chart text{fill:var(--muted);font-size:11px;font-family:var(--body)}
.chart .s1{stroke:var(--accent);fill:none;stroke-width:2.5}
.chart .s1a{fill:var(--accent);opacity:.12}
.chart .s2{stroke:var(--muted);fill:none;stroke-width:1.5;stroke-dasharray:4 4}
.chart .dot{fill:var(--accent)}
.chart .tgt{stroke:var(--ok);stroke-width:1.5;stroke-dasharray:6 4}
.chart .tgtl{fill:var(--ok)}
.legend{display:flex;gap:14px;font-size:12px;color:var(--muted);flex-wrap:wrap}
.legend i{display:inline-block;width:14px;height:3px;vertical-align:middle;margin-right:5px;background:var(--accent)}
.legend i.d{background:repeating-linear-gradient(90deg,var(--muted) 0 4px,transparent 4px 8px)}
.legend i.g{background:repeating-linear-gradient(90deg,var(--ok) 0 6px,transparent 6px 10px)}
/* forms */
label.f{display:flex;flex-direction:column;gap:3px;font-size:12px;color:var(--muted);font-weight:600;min-width:0}
input.in,select.in,textarea.in{border:1px solid var(--line);background:var(--surface);border-radius:7px;padding:7px 9px;font-size:15px;width:100%;min-width:0;color:var(--fg)}
input.in.n{max-width:84px}
.fgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px}
.prow{display:grid;grid-template-columns:minmax(0,1.8fr) repeat(6,minmax(0,1fr)) auto;gap:6px;align-items:end;padding:8px 0;border-top:1px solid var(--line)}
.prow .ctl{display:flex;gap:4px}
@media (max-width:560px){.prow{grid-template-columns:repeat(3,minmax(0,1fr))}.prow .exsel{grid-column:1/-1}.prow .ctl{grid-column:1/-1;justify-content:flex-end}}
.tpl{display:flex;flex-direction:column;gap:6px}
.tpl.cur{border-color:var(--accent)}
.empty{color:var(--muted);font-size:14px;padding:12px 0}
#modal{position:fixed;inset:0;z-index:40;background:rgba(0,0,0,.5);display:grid;place-items:center;padding:16px}
#modal .mbox{background:var(--surface);border-radius:14px;max-width:520px;width:100%;max-height:85vh;overflow:auto;padding:18px;display:flex;flex-direction:column;gap:12px}
.sum-line{display:flex;gap:8px;align-items:flex-start;font-size:14px}
.sum-line .ic{font-family:var(--display);font-weight:700;width:18px;flex-shrink:0;text-align:center}
.banner{font-size:13px;padding:8px 12px;border-radius:8px;background:var(--warn-soft);color:var(--warn)}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

</head>
<body>
<header class="top"><div class="wrap">
  <div class="brand"><img id="app-icon" src="data:image/png;base64," alt="" width="30" height="30" style="border-radius:7px;display:block">Lifting Log</div>
  <span id="sync" class="pill">Loading…</span>
</div></header>
<main class="wrap" id="view" aria-live="polite"></main>
<div id="timer" hidden></div>
<div id="modal" hidden></div>
<nav class="tabs" aria-label="Sections"><div class="tin" id="tabs"></div></nav>

<script>
(function(){
"use strict";
/* ---------- Exercise library (fits: barbell + rack + bench, high/low plate-loaded cable, 5 kg dumbbells) ---------- */
const EX={
  squat:{n:"Squat",k:"barbell",pat:"Squat",w:100},
  front_squat:{n:"Front Squat",k:"barbell",pat:"Squat",w:70},
  split_squat:{n:"Dumbbell Split Squat",k:"dumbbell",pat:"Squat",w:5},
  bench:{n:"Bench Press",k:"barbell",pat:"Horizontal push",w:80},
  cg_bench:{n:"Close-Grip Bench",k:"barbell",pat:"Horizontal push",w:65,note:"Hands just inside shoulder width, elbows tucked. Good carryover to your bench."},
  floor_press:{n:"Floor Press",k:"barbell",pat:"Horizontal push",w:70,note:"Shorter range, easier on a clicky shoulder."},
  incline:{n:"Incline Bench Press",k:"barbell",pat:"Horizontal push",w:60},
  pushup:{n:"Push-up",k:"bodyweight",pat:"Horizontal push",w:0},
  ohp:{n:"Overhead Press",k:"barbell",pat:"Vertical push",w:50,note:"Shoulder clicks: brace hard, keep the bar close to your face, stop the set if it turns painful."},
  lateral_raise:{n:"Lateral Raise",k:"dumbbell",pat:"Vertical push",w:5},
  deadlift:{n:"Deadlift",k:"barbell",pat:"Hinge",w:115},
  rdl:{n:"Romanian Deadlift",k:"barbell",pat:"Hinge",w:80},
  pull_through:{n:"Cable Pull-Through",k:"cable",pat:"Hinge",w:20,note:"Low pulley, rope between the legs."},
  row:{n:"Barbell Row",k:"barbell",pat:"Horizontal pull",w:80},
  cable_row:{n:"Seated Cable Row",k:"cable",pat:"Horizontal pull",w:30,note:"Low pulley. Pause with the handle at your stomach."},
  lat_pulldown:{n:"Lat Pulldown",k:"cable",pat:"Vertical pull",w:30,note:"High pulley. Use a neutral handle if you have one."},
  face_pull:{n:"Face Pull",k:"cable",pat:"Shoulder care",w:10,note:"High pulley, rope. Pull to your forehead, thumbs back. Shoulder prehab, keep it light."},
  rope_pushdown:{n:"Rope Pushdown",k:"cable",pat:"Arms",w:15,note:"High pulley. The neutral rope grip is kinder on the elbows than a straight bar."},
  cable_curl:{n:"Rope Cable Curl",k:"cable",pat:"Arms",w:10,note:"Low pulley, rope for a neutral grip."},
  hammer_curl:{n:"Hammer Curl",k:"dumbbell",pat:"Arms",w:5,note:"Neutral grip, easier on the elbows. Weight shown is per dumbbell."},
  burpee:{n:"Burpee",k:"bodyweight",pat:"Conditioning",w:0,note:"Keep a steady pace. Step back instead of jumping if your knees or shoulder complain."},
  mountain_climber:{n:"Mountain Climber",k:"bodyweight",pat:"Conditioning",w:0,note:"Count each leg as one rep. Hands under shoulders, hips low."},
  wrist_ext:{n:"Wrist Extension",k:"dumbbell",pat:"Elbow care",w:5,note:"Tennis-elbow rehab: lower slowly over 3–4 s. Mild ache is OK, sharp pain is not."}
};
const PATTERNS=["Squat","Horizontal push","Vertical push","Hinge","Horizontal pull","Vertical pull","Shoulder care","Arms","Elbow care","Conditioning"];
const R=(ex,sets,lo,hi,rest,extra)=>Object.assign({ex,sets,lo,hi:hi==null?lo:hi,rest,inc:EX[ex].k==="fixed"||EX[ex].k==="bodyweight"?0:2.5,pct:100},extra||{});
const TEMPLATES={
  hybrid:{name:"Hybrid strength + size",blurb:"Heavy 5×5 on squat and bench (your two goal lifts), moderate reps on everything else. Face pulls for the shoulder, neutral-grip arm work for the elbows. About 50–60 min.",
    A:[R("squat",5,5,5,150),R("bench",5,5,5,150),R("row",3,8,10,90),R("face_pull",3,12,15,45),R("rope_pushdown",2,12,15,45)],
    B:[R("squat",3,8,8,120,{pct:85}),R("ohp",3,8,10,120),R("deadlift",1,5,5,180,{backoff:{sets:1,reps:8,pct:85}}),R("cable_row",3,10,12,75),R("hammer_curl",2,10,15,45)]},
  classic:{name:"Classic 5×5",blurb:"The original three-lift A/B 5×5 with +2.5 kg every session you hit all reps. Short sessions, pure strength.",
    A:[R("squat",5,5,5,180),R("bench",5,5,5,180),R("row",5,5,5,180)],
    B:[R("squat",5,5,5,180),R("ohp",5,5,5,180),R("deadlift",1,5,5,180)]},
  volume:{name:"3×8 size block",blurb:"Close to how you train now. Moderate weight, more reps, double progression (weight goes up once you hit the top of the range).",
    A:[R("squat",3,8,8,150),R("bench",3,8,8,150),R("row",3,8,10,120),R("rope_pushdown",3,10,15,60)],
    B:[R("squat",3,8,8,150),R("ohp",3,8,10,150),R("deadlift",2,8,10,150),R("lat_pulldown",3,10,12,90),R("hammer_curl",2,10,15,60)]},
  fatloss:{name:"Fat-loss 30",days:4,blurb:"Four shorter sessions a week (about 30 min each), alternating A and B. One heavy 3×5 lift keeps your strength, then quicker accessory work on 45–60 s rest and a conditioning finisher to keep your heart rate up.",
    A:[R("squat",3,5,5,120),R("row",3,8,12,60),R("face_pull",2,12,15,30),R("burpee",3,8,12,30)],
    B:[R("bench",3,5,5,120),R("deadlift",1,5,5,120,{backoff:{sets:1,reps:8,pct:85}}),R("cable_row",3,10,12,45),R("mountain_climber",3,20,30,30)]},
  bench:{name:"Bench focus",blurb:"Bench twice a week (heavy on A, close-grip volume on B) to push towards 120 kg, with squat heavy on A only.",
