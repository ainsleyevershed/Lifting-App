function csv(){const rows=[["date","workout","exercise","weight_kg","set","reps","type"]];S.slice().reverse().forEach(s=>s.items.forEach(o=>{o.reps.forEach((r,j)=>rows.push([s.date.slice(0,10),s.imp?"Gym Day":s.day,o.n,wAt(o,j),j+1,r==null?"":r,"work"]));if(o.bo)o.bo.reps.forEach((r,j)=>rows.push([s.date.slice(0,10),s.day,o.n,o.bo.w,j+1,r==null?"":r,"back-off"]))}));return rows.map(r=>r.map(c=>/[",\n]/.test(String(c))?'"'+String(c).replace(/"/g,'""')+'"':c).join(",")).join("\n")}
async function offer(filename,data){
