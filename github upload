/* ---------- training maths ---------- */
function minW(ex){const k=EX[ex]?EX[ex].k:"";return k==="barbell"?P.settings.bar:k==="dumbbell"?P.settings.dbHandle:0}
function rowWeight(row){const st=P.state[row.ex]||{w:0};let w=st.w;if(row.pct&&row.pct<100)w=r25(w*row.pct/100);w=Math.max(minW(row.ex),w);return w}
function schemeLabel(row){
  let s=row.sets+"×"+(row.lo===row.hi?row.lo:row.lo+"–"+row.hi);
  if(row.backoff)s+=" + "+row.backoff.sets+"×"+row.backoff.reps+" @ "+row.backoff.pct+"%";
  if(row.pct<100)s+=" @ "+row.pct+"% of heavy "+exName(row.ex).toLowerCase();
  return s;
}
function platesFor(total,perSide){
  const bar=P.settings.bar; let rem=perSide?(total-bar)/2:total;
  if(rem<-1e-9)return{ok:false,list:[],rem};
  const pl=P.settings.plates; const sizes=Object.keys(pl).map(Number).filter(n=>n>0).sort((a,b)=>b-a);
  const out=[];
  for(const s of sizes){let avail=perSide?Math.floor((pl[String(s)]||0)/2):(pl[String(s)]||0);while(avail>0&&rem>=s-1e-9){out.push(s);rem-=s;avail--}}
  return{ok:Math.abs(rem)<1e-6,list:out,rem};
}
function maxLoad(){const pl=P.settings.plates;let t=P.settings.bar;Object.keys(pl).forEach(k=>t+=Number(k)*(Math.floor(pl[k]/2)*2));return t}
function dbPlates(w){const h=P.settings.dbHandle;let rem=(w-h)/2;if(rem<-1e-9)return{ok:false,list:[]};const pl=P.settings.plates,out=[];
  Object.keys(pl).map(Number).filter(n=>n>0).sort((a,b)=>b-a).forEach(s=>{let avail=Math.floor((pl[String(s)]||0)/4);while(avail>0&&rem>=s-1e-9){out.push(s);rem-=s;avail--}});
  return{ok:Math.abs(rem)<1e-6,list:out}}
function dbViz(w){const r=dbPlates(w);if(!r.ok)return `<div class="plates"><span class="note bad">Can't make ${fmt(w)} kg dumbbells exactly with your plates (each size needs 4 plates for a pair)</span></div>`;
  if(!r.list.length)return `<div class="plates">Empty ${fmt(P.settings.dbHandle)} kg handles</div>`;
  return `<div class="plates"><div class="pviz" aria-hidden="true" style="height:30px;transform:scale(.75);transform-origin:left center"><span class="sleeve"></span><span class="collar"></span>${r.list.map(s=>`<span class="plate ${plateCls(s)}"></span>`).join("")}</div><span>Each dumbbell, each side: <b class="num" style="color:var(--fg);font-size:15px">${r.list.map(fmt).join(" + ")}</b></span></div>`}
function plateCls(s){return {20:"p20",15:"p15",10:"p10",5:"p5",2.5:"p2_5",1.25:"p1_25"}[s]||"pother"}
function plateViz(total){
  const r=platesFor(total,true);
  if(!r.ok)return `<div class="plates"><span class="note bad">Can't load ${fmt(total)} kg exactly with your plates</span></div>`;
  if(!r.list.length)return `<div class="plates">Empty bar</div>`;
  return `<div class="plates"><div class="pviz" aria-hidden="true"><span class="sleeve"></span><span class="collar"></span>${r.list.map(s=>`<span class="plate ${plateCls(s)}"></span>`).join("")}</div><span>Each side: <b class="num" style="color:var(--fg);font-size:15px">${r.list.map(fmt).join(" + ")}</b></span></div>`;
}
function warmups(row,W){
  if(EX[row.ex].k!=="barbell")return[];
  const bar=P.settings.bar,out=[];
  const light=row.pct<100;
  if(row.ex!=="deadlift"&&row.ex!=="row"&&row.ex!=="rdl")out.push({w:bar,r:light?5:5,x:light?1:2});
  const steps=light?[[.55,5],[.75,3]]:[[.4,5],[.6,3],[.8,2]];
  let last=out.length?bar:0;
  for(const [p,r] of steps){let w=Math.round(W*p/5)*5;if(row.ex==="deadlift")w=Math.max(w,60);if(w>last&&w<W-1e-9&&w>=bar){out.push({w,r,x:1});last=w}}
  return out;
}
function estMinutes(rows){let s=0;rows.forEach(r=>{const n=r.sets+(r.backoff?r.backoff.sets:0);s+=n*35+(n-1)*r.rest+60;s+=warmups(r,rowWeight(r)).reduce((a,w)=>a+w.x,0)*45});return Math.round(s/60)+6}
const HEAVY_EX=["squat","bench"];
