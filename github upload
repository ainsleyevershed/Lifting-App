    h+=`<div class="sets" role="group" aria-label="Work sets">${it.reps.map((r,j)=>setBtn(r,row.lo,row.hi,i,j,"s")).join("")}</div>`;
    if(row.backoff){const bw=r25(it.w*row.backoff.pct/100);h+=`<div class="sets"><span class="setlbl">Back-off at ${fmt(bw)} kg (${row.backoff.pct}%) · each side ${platesFor(bw,true).list.map(fmt).join("+")||"bar"}</span>${it.bo.map((r,j)=>setBtn(r,row.backoff.reps,row.backoff.reps,i,j,"b")).join("")}</div>`}
    const notes=[];
    if(drive&&st.f>0&&kind!=="fixed")notes.push(`<div class="note warn">Missed reps last time (${st.f} of 3 before a 10% deload).</div>`);
    if(!drive)notes.push(`<div class="note">Volume work: follows your heavy ${esc(ex.n.toLowerCase())} weight, doesn't progress on its own.</div>`);
    if(ex.note)notes.push(`<div class="note">${esc(ex.note)}</div>`);
    if(it.pain){const alts=Object.keys(EX).filter(k=>k!==row.ex&&EX[k].pat===ex.pat).map(exName);notes.push(`<div class="note bad">Flagged: weight will be held next time instead of going up.${alts.length?" If it keeps happening, swap it on the Plan tab for: "+esc(alts.join(", "))+".":""}</div>`)}
    h+=notes.join("");
    h+=`<div><button class="toggle ${it.pain?"on":""}" data-act="pain" data-i="${i}" aria-pressed="${it.pain}">${it.pain?"Elbow/shoulder niggle flagged":"Flag elbow/shoulder niggle"}</button></div></section>`;
  });
  if(rows.length){h+=`<label class="f">Session notes<textarea class="in" id="sess-notes" rows="2" placeholder="How did it feel? Sleep, energy, anything odd">${esc(D.notes||"")}</textarea></label>`;
    h+=`<button class="btn primary big" data-act="finish">Finish workout ${day}</button>`;
    if(D.started)h+=`<button class="btn ghost sm" data-act="discard" style="align-self:center">${ui.confirm==="discard"?"Tap again to discard this session":"Discard this session"}</button>`;}
  h+=`<p class="muted small">Tap a set circle when you finish it: it fills with the target reps. Tap again to take off a rep if you fell short. The rest timer starts on its own, with 90 seconds extra after a missed set. Time estimates include about 6 minutes for your own warm-up and cool-down.</p></div>`;
  return h;
}
function setBtn(r,lo,hi,i,j,t){
  let cls="set",txt=hi;
  if(r!=null){txt=r;cls+=r>=hi?" hit":r>=lo?" mid":" part"}
  return `<button class="${cls}" data-act="set" data-t="${t}" data-i="${i}" data-j="${j}" aria-label="Set ${j+1}: ${r==null?"not done":r+" reps"}">${txt}</button>`;
}

function finishWorkout(){
  const day=D.day,rows=rowsFor(day);
  const any=D.items.some(it=>it.reps.some(r=>r!=null));
  if(!any){openModal(`<h2>Nothing logged yet</h2><p>Tap the set circles as you complete each set, then finish the workout.</p><button class="btn primary" data-act="close">OK</button>`);return}
  const missing=D.items.reduce((a,it)=>a+it.reps.filter(r=>r==null).length,0);
  if(missing&&ui.confirm!=="finish"){ui.confirm="finish";openModal(`<h2>${missing} set${missing>1?"s":""} not logged</h2><p class="muted">Sets you didn't tap count as missed for progression. Exercises you skipped completely are left unchanged.</p><div class="row"><button class="btn primary" data-act="finish">Finish anyway</button><button class="btn" data-act="close">Keep training</button></div>`);return}
  ui.confirm=null;
  const changes=[],prs=[];
  const items=rows.map((row,i)=>{const it=D.items[i];const o={ex:row.ex,n:exName(row.ex),k:EX[row.ex].k,w:it.w,sets:row.sets,lo:row.lo,hi:row.hi,pct:row.pct||100,reps:it.reps.slice(),pain:!!it.pain};if(row.backoff)o.bo={w:r25(it.w*row.backoff.pct/100),target:row.backoff.reps,reps:it.bo.slice()};return o});
  // PRs
  items.forEach(o=>{if(o.k!=="barbell"&&o.k!=="cable"&&o.k!=="dumbbell")return;const best=Math.max(0,...o.reps.map(r=>e1rm(o.w,r||0)));const all=bestE1(o.ex),rec=bestE1(o.ex,Date.now()-84*864e5);
    if(best>0&&all>0&&best>all+0.01)prs.push(`${o.n}: new all-time best estimated 1RM, ${fmt(Math.round(best*2)/2)} kg (was ${fmt(Math.round(all*2)/2)})`);
    else if(best>0&&rec>0&&best>rec+0.01)prs.push(`${o.n}: best estimated 1RM in 12 weeks, ${fmt(Math.round(best*2)/2)} kg`)});
  // progression
  rows.forEach((row,i)=>{
    const o=items[i],st=P.state[row.ex],k=EX[row.ex].k;
    if((row.pct||100)<100)return;
    if(o.reps.every(r=>r==null)){changes.push(["–",`${o.n}: skipped, stays at ${fmt(st.w)} kg`]);return}
    if(k==="barbell"||k==="cable"||k==="dumbbell")st.w=o.w;
    const allTop=o.reps.every(r=>r!=null&&r>=row.hi),anyLow=o.reps.some(r=>r==null||r<row.lo);
    if(o.pain){changes.push(["!",`${o.n}: niggle flagged, holding at ${fmt(st.w)} kg`]);return}
    if(allTop){
      if(row.inc>0){st.w=Math.round((st.w+row.inc)*100)/100;st.f=0;changes.push(["+",`${o.n}: all reps hit, ${fmt(st.w)} kg next time`])}
      else{st.f=0;changes.push(["+",`${o.n}: top of the range hit. Add a rep, slow the tempo, or swap to a harder variation`])}
    }else if(anyLow){
      st.f=(st.f||0)+1;
      if(st.f>=3&&row.inc>0){const nw=Math.max(minW(row.ex),r25(st.w*0.9));changes.push(["↓",`${o.n}: third session short of reps. Deloading 10% to ${fmt(nw)} kg to build back up`]);st.w=nw;st.f=0}
      else changes.push(["·",`${o.n}: missed reps, repeat ${fmt(st.w)} kg (${st.f} of 3 before deload)`]);
    }else{st.f=0;changes.push(["=",`${o.n}: in range, stay at ${fmt(st.w)} kg until you hit ${row.sets}×${row.hi}`])}
  });
  const dur=D.started?Math.round((Date.now()-new Date(D.started).getTime())/60000):null;
  const sess={id:uid(),date:new Date().toISOString(),day,tpl:P.plan.tpl,items,notes:(D.notes||"").trim(),mins:dur,changes:changes.map(c=>c[1]),prs};
  S.unshift(sess);P.next=day==="A"?"B":"A";
  D=null;lsDel("ll.draft");stopTimer();try{wl&&wl.release()}catch(e){}
  saveDoc("sessions",sess);saveProfile();
  openModal(`<div class="eyebrow">Workout ${day} saved${dur?" · "+dur+" min":""}</div><h2>Session summary</h2>
    ${prs.length?`<div class="stack" style="gap:6px">${prs.map(p=>`<div class="note ok">${esc(p)}</div>`).join("")}</div>`:""}
    <div class="stack" style="gap:6px">${changes.map(c=>`<div class="sum-line"><span class="ic">${esc(c[0])}</span><span>${esc(c[1])}</span></div>`).join("")}</div>
    <p class="muted small">Next up: Workout ${P.next}.</p><button class="btn primary" data-act="close">Done</button>`);
  render();
}
function bestE1(ex,since){let b=0;S.forEach(s=>{if(since&&new Date(s.date).getTime()<since)return;s.items.forEach(o=>{if(o.ex!==ex)return;o.reps.forEach((r,j)=>{if(r)b=Math.max(b,e1rm(wAt(o,j),r))})})});return b}

/* ---- History ---- */
