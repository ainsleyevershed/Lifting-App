    case "prog":ui.progEx=v;render();break;
    case "del-bw":if(ui.confirm==="bw-"+v){BW=BW.filter(x=>x.id!==v);ui.confirm=null;delDoc("body",v)}else ui.confirm="bw-"+v;render();break;
    case "use-tpl":if(ui.tplConfirm===v){P.plan={tpl:v,A:clone(TEMPLATES[v].A),B:clone(TEMPLATES[v].B)};P.settings.days=TEMPLATES[v].days||3;ui.tplConfirm=null;D=null;lsDel("ll.draft");saveProfile()}else ui.tplConfirm=v;render();break;
    case "pm":{const L=P.plan[day],k=i+(+v);if(k<0||k>=L.length)break;[L[i],L[k]]=[L[k],L[i]];P.plan.tpl="custom";saveProfile();render();break}
    case "pdel":P.plan[day].splice(i,1);P.plan.tpl="custom";saveProfile();render();break;
    case "padd":P.plan[day].push(R("face_pull",3,12,15,60));P.plan.tpl="custom";saveProfile();render();break;
    case "pbo":{const r=P.plan[day][i];if(r.backoff)delete r.backoff;else r.backoff={sets:1,reps:8,pct:85};P.plan.tpl="custom";saveProfile();render();break}
    case "st-reset":P.state[v].f=0;saveProfile();render();break;
    case "goal-add":P.settings.goals.push({ex:"deadlift",target:180});saveProfile();render();break;
    case "goal-del":P.settings.goals.splice(i,1);saveProfile();render();break;
    case "exp-json":offer("lifting-log-"+todayISO()+".json",JSON.stringify({app:"lifting-log",v:1,exported:new Date().toISOString(),profile:P,sessions:S,body:BW},null,1));break;
    case "exp-csv":offer("lifting-log-sets-"+todayISO()+".csv",csv());break;
    case "copy":{const t=document.getElementById("exp-text");if(navigator.clipboard)navigator.clipboard.writeText(t.value).then(()=>{b.textContent="Copied"},()=>{t.select()});else t.select();break}
    case "imp-go":doImport();break;
    case "bk-hint":lsSet("ll.bkHint",1);render();break;
    case "save-icon":(async()=>{const out=document.getElementById("icon-out");let dl=null;try{dl=window.claude&&window.claude.use?await window.claude.use("downloads"):null}catch(e){}
      if(!dl){const a=document.createElement("a");a.href=document.getElementById("app-icon").src;a.download="lifting-log-icon.png";document.body.appendChild(a);a.click();a.remove();out.innerHTML=`<div class="note ok">Icon downloaded.</div>`;return}
      const bin=atob(document.getElementById("app-icon").src.split(",")[1]),u=new Uint8Array(bin.length);for(let k=0;k<bin.length;k++)u[k]=bin.charCodeAt(k);
      try{await dl.save({filename:"lifting-log-icon.png",data:new Blob([u],{type:"image/png"})});out.innerHTML=`<div class="note ok">Icon saved.</div>`}catch(e){out.innerHTML=e&&e.code==="declined"?"":`<div class="note">Couldn't save. Press and hold the icon above and choose "Download image".</div>`}})();break;
    case "heavy":{if(D&&D.started)break;const ch=setHeavy(v);if(D&&!D.started)D=null;saveProfile();render();if(ch.length)openModal(`<h2>Switched to ${SCHEMES[v].label}</h2><p>Squat and bench heavy sets are now ${v==="3x5"?"3 sets of 5 with 3 min rest":"5 sets of 5"}.</p><div class="stack" style="gap:6px">${ch.map(c=>`<div class="note">${esc(c)}</div>`).join("")}</div><p class="small muted">You can fine-tune these on the Train page or in Settings. Progression rules stay the same: hit every rep and add 2.5 kg.</p><button class="btn primary" data-act="close">OK</button>`);break}
    case "hist-more":ui.histN=(ui.histN||40)+60;render();break;
    case "range":ui.range=v;render();break;
    case "rm-imp":if(ui.confirm==="rm-imp"){const gone=S.filter(s=>s.imp);S=S.filter(s=>!s.imp);ui.confirm=null;render();(async()=>{if(mode==="cloud"){for(let k=0;k<gone.length;k+=8)await Promise.all(gone.slice(k,k+8).map(s=>refs.prof.collection("sessions").doc(s.id).delete().catch(()=>{})))}cacheLocal();setSync(mode==="cloud"?"ok":"warn",mode==="cloud"?"Saved":"Saving on this device only")})()}else{ui.confirm="rm-imp";render()}break;
  }
});
document.addEventListener("change",e=>{
  const el=e.target,a=el.dataset.act;
  if(el.id==="imp-file"&&el.files&&el.files[0]){handleImport(el.files[0]);el.value="";return}
  if(el.id==="imp-gd"&&el.files&&el.files[0]){importGymDay(el.files[0]);el.value="";return}
  if(a==="prog-sel"){if(el.value){ui.progEx=el.value;render()}return}
  if(!a)return;
  if(a==="pe"){const r=P.plan[el.dataset.d][+el.dataset.i],f=el.dataset.f;
    if(f==="ex"){r.ex=el.value;const k=EX[el.value].k;if(k==="fixed"||k==="bodyweight")r.inc=0;else if(!r.inc)r.inc=2.5;if(k!=="barbell")delete r.backoff}
    else{let n=parseFloat(el.value);if(isNaN(n))return;if(f==="pct")n=Math.min(100,Math.max(40,n));r[f]=n;if(f==="lo"&&r.hi<n)r.hi=n;if(f==="hi"&&r.lo>n)r.lo=n}
    P.plan.tpl="custom";D=null;lsDel("ll.draft");saveProfile();render();return}
  if(a==="st"){const n=parseFloat(el.value);if(!isNaN(n)&&n>=0){P.state[el.dataset.v].w=n;if(D&&!D.started)D=null;saveProfile()}return}
  if(a==="dbh"){const n=parseFloat(el.value);if(!isNaN(n)&&n>0){P.settings.dbHandle=n;Object.keys(EX).forEach(k=>{if(EX[k].k==="dumbbell"&&P.state[k].w<n)P.state[k].w=n});saveProfile();render()}return}
  if(a==="days"){P.settings.days=parseInt(el.value,10)||3;saveProfile();return}
  if(a==="bar"){const n=parseFloat(el.value);if(!isNaN(n)&&n>0){P.settings.bar=n;saveProfile();render()}return}
  if(a==="plate"){const n=parseInt(el.value,10);if(!isNaN(n)&&n>=0){P.settings.plates[el.dataset.v]=n;saveProfile();render()}return}
  if(a==="goal"){const g=P.settings.goals[+el.dataset.i];if(el.dataset.f==="ex")g.ex=el.value;else{const n=parseFloat(el.value);if(!isNaN(n)&&n>0)g.target=n}saveProfile();return}
  if(a==="sound"){P.settings.sound=el.checked;saveProfile();return}
});
