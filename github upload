  const y=ui.calY,m=ui.calM,first=new Date(y,m,1),start=(first.getDay()+6)%7,dim=new Date(y,m+1,0).getDate();
  const byDay={};S.forEach(s=>{const d=new Date(s.date);const k=d.getFullYear()+"-"+d.getMonth()+"-"+d.getDate();byDay[k]=s.imp?"GD":s.day});
