function setHeavy(to){const rs=heavyRows();if(!rs.length)return [];const T=SCHEMES[to],changed=[],seen=new Set();
  rs.forEach(r=>{const from=rowScheme(r);if(from===to)return;const F=SCHEMES[from];r.sets=T.sets;r.lo=T.reps;r.hi=T.reps;r.rest=to==="5x5"?Math.min(Math.max(r.rest,150),180):Math.max(r.rest,180);
